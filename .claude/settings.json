{
  "model": "opus",
  "sandbox": {
    "network": {
      "allowedDomains": ["static.rust-lang.org", "static.crates.io", "storage.googleapis.com", "index.crates.io", "reservoir.lean-lang.org", "github.com"]
    }
  },
  "permissions": {
    "ask": [
      "Edit(.claude/settings.json)",
      "Write(.claude/settings.json)",
      "Edit(README.md)",
      "Write(README.md)",
      "Edit(Challenge.lean)",
      "Write(Challenge.lean)",
      "Edit(challenge.json)",
      "Write(challenge.json)",
      "Edit(CertCheck.lean)",
      "Write(CertCheck.lean)",
      "Edit(Random/Concrete/**)",
      "Write(Random/Concrete/**)",
      "Bash(git push)",
      "Bash(git push *)",
      "Edit(.github/**)",
      "Write(.github/**)",
      "Edit(.githooks/**)",
      "Write(.githooks/**)",
      "Edit(scripts/sorry-gate)",
      "Write(scripts/sorry-gate)",
      "Edit(c/**)",
      "Write(c/**)",
      "Edit(Random/Bench/TestMmap.lean)",
      "Write(Random/Bench/TestMmap.lean)",
      "Edit(AKS/Seiferas.lean)",
      "Write(AKS/Seiferas.lean)",
      "Edit(**/Axioms.lean)",
      "Write(**/Axioms.lean)"
    ],
    "allow": [
      "Bash(cat *)",
      "Bash(git add *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git commit)",
      "Bash(git commit *)",
      "Bash(git pull *)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(lake build)",
      "Bash(lake build *)",
      "Bash(lake exe cache get)",
      "Bash(lake clean)",
      "Bash(ls *)",
      "Bash(mkdir *)",
      "Bash(chmod *)",
      "Bash(scripts/extract-history)",
      "Bash(scripts/sorries)",
      "Bash(test *)",
      "Bash(wc *)",
      "Bash(head *)",
      "Bash(head)",
      "Bash(tail *)",
      "Bash(tail)",
      "Bash(lake env lean *)",
      "Bash(cargo *)",
      "Bash(rg *)",
      "Bash(grep *)",
      "Bash(ps *)",
      "Bash(pkill -f lean*)",
      "Bash(pkill -f lake*)",
      "Bash(scripts/update-viz-lines)",
      "Bash(scripts/update-viz-lines *)",
      "Bash(scripts/sorries *)",
      "Bash(scripts/sorry-gate)",
      "Bash(scripts/sorry-gate *)",
      "Bash(scripts/bench)",
      "Bash(scripts/bench *)",
      "Bash(scripts/download-certificates)",
      "Write(/tmp/*)",
      "mcp__lean__snippet",
      "mcp__lean__check",
      "mcp__lean__restart"
    ]
  }
}
