#!/usr/bin/env python3
"""Report the largest .lean files in AKS/ by non-comment lines.

Always shows at least 10 files and all files over 600 non-comment lines.
Uses a color ramp from green (small) through yellow/red (large).

Comment lines (starting with optional whitespace then `--` or `/-`) and
blank lines are excluded from the count, so well-commented files aren't
penalized.
"""

import os
import re
import sys

# ── Configuration ──────────────────────────────────────────────
MIN_DISPLAY = 10       # always show at least this many
LINE_THRESHOLD = 600   # always show files above this

# Color ramp breakpoints (lines → ANSI 256-color index)
# green → yellow → orange → red → bright red
RAMP = [
    (200,  34),   # green
    (400,  118),  # light green
    (600,  75),   # blue
    (800,  214),  # orange
    (1000, 196),  # red
    (2000, 160),  # dark red
    (4000, 88),   # deep red
]

# Matches blank lines, single-line comments (-- ...), and block comment
# delimiters (/- ... -/).  Lean block comments can nest, so we track depth.
_COMMENT_START = re.compile(r'^\s*/\-')
_COMMENT_END   = re.compile(r'-/')
_LINE_COMMENT  = re.compile(r'^\s*--')

def count_noncomment_lines(path: str) -> tuple[int, int]:
    """Return (non_comment_lines, total_lines) for a Lean file."""
    total = 0
    code = 0
    depth = 0  # nesting depth of /- -/ block comments
    with open(path) as f:
        for line in f:
            total += 1
            stripped = line.strip()
            if depth > 0:
                # Inside a block comment — count /- and -/ to track nesting
                depth += len(re.findall(r'/\-', line))
                depth -= len(re.findall(r'-/', line))
                continue
            # Check for block comment opening
            if _COMMENT_START.match(line):
                depth += len(re.findall(r'/\-', line))
                depth -= len(re.findall(r'-/', line))
                continue
            # Skip single-line comments and blank lines
            if not stripped or _LINE_COMMENT.match(line):
                continue
            code += 1
    return code, total

def color_for(lines: int) -> str:
    """Return ANSI escape for 256-color based on line count."""
    if not sys.stdout.isatty():
        return ""
    idx = RAMP[-1][1]
    for threshold, c in RAMP:
        if lines <= threshold:
            idx = c
            break
    return f"\033[38;5;{idx}m"

RESET = "\033[0m" if sys.stdout.isatty() else ""
BOLD  = "\033[1m" if sys.stdout.isatty() else ""
DIM   = "\033[2m" if sys.stdout.isatty() else ""

def main():
    root = os.path.join(os.path.dirname(os.path.abspath(__file__)), "..")
    aks_dir = os.path.join(root, "AKS")

    # Collect all .lean files with line counts
    entries = []
    for dirpath, _, filenames in os.walk(aks_dir):
        for fn in filenames:
            if fn.endswith(".lean"):
                path = os.path.join(dirpath, fn)
                code, total = count_noncomment_lines(path)
                rel = os.path.relpath(path, root)
                entries.append((code, total, rel))

    entries.sort(key=lambda e: -e[0])

    # Determine how many to show
    n_above = sum(1 for code, _, _ in entries if code > LINE_THRESHOLD)
    n_show = max(MIN_DISPLAY, n_above)
    shown = entries[:n_show]

    if not shown:
        print("No .lean files found in AKS/")
        return

    max_lines = shown[0][0]
    bar_width = 40

    # Header
    print(f"\n{BOLD}  Largest AKS/*.lean files (non-comment lines){RESET}")
    print(f"  {DIM}{'─' * 60}{RESET}\n")

    for code, total, path in shown:
        c = color_for(code)
        bar_len = int(code / max_lines * bar_width) if max_lines > 0 else 0
        bar = "█" * bar_len + "░" * (bar_width - bar_len)
        comment_pct = 100 * (total - code) / total if total > 0 else 0

        print(f"  {c}{code:5d}{RESET}  {c}{bar}{RESET}  {path}"
              f"  {DIM}({total} total, {comment_pct:.0f}% comments){RESET}")

    # Summary
    total_code = sum(code for code, _, _ in entries)
    total_all  = sum(total for _, total, _ in entries)
    n_over = sum(1 for code, _, _ in entries if code > LINE_THRESHOLD)
    print(f"\n  {DIM}{'─' * 60}{RESET}")
    print(f"  {len(entries)} files, {total_code} code lines ({total_all} total), "
          f"{BOLD}{n_over}{RESET} over {LINE_THRESHOLD}\n")

if __name__ == "__main__":
    main()
